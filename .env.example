# Variables de Configuración de IntelliTaxi
# INSTRUCCIONES: Copia este archivo como '.env' y completa con tus credenciales reales

# API Configuration
BASE_URL=https://tu-servidor.com/api/
# Ruta POST (Bearer) para guardar token FCM tras login o onTokenRefresh
DEVICE_TOKEN_SYNC_PATH=update_device_token

# Google Maps API Key (solo mapa visual google_maps_flutter; geocode/rutas vía backend)
# Obtén tu clave en: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=TU_GOOGLE_MAPS_API_KEY_AQUI

# Geocode, autocomplete y rutas usan /api/taxi/* (Nominatim + OSRM). false = legacy Google HTTP.
# USE_BACKEND_MAPS_PROXY=true

# WebSocket taxis — mismos valores que Laravel (SOCKET_* en .env del backend)
# Soketi / laravel-websockets en tu VPS. NO Pusher.com
SOCKET_APP_ID=1
SOCKET_APP_KEY=key-virtualt0001
SOCKET_APP_SECRET=secret-virtualt0001
SOCKET_APP_CLUSTER=mt1
SOCKET_HOST=148.113.182.92
SOCKET_PORT=8001
SOCKET_SCHEME=http

# App Settings
DEFAULT_RADIUS=20
OFFER_EXPIRATION_MINUTES=5
DEFAULT_ZOOM=15.0


dart run tool/sync_app_version.dart
flutter build apk --release
cp build/app/outputs/flutter-apk/app-release.apk "build/app/outputs/flutter-apk/TaxbelUrbanoV-$(grep '^version:' pubspec.yaml | awk '{print $2}').apk"