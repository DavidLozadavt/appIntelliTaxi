# Variables de Configuración de IntelliTaxi
# INSTRUCCIONES: Copia este archivo como '.env' y completa con tus credenciales reales

# API Configuration
BASE_URL=https://tu-servidor.com/api/

# Google Maps API Key (solo mapa visual google_maps_flutter; geocode/rutas vía backend)
# Obtén tu clave en: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=TU_GOOGLE_MAPS_API_KEY_AQUI

# Geocode, autocomplete y rutas usan /api/taxi/* (Nominatim + OSRM). false = legacy Google HTTP.
# USE_BACKEND_MAPS_PROXY=true

# Pusher Configuration
# Obtén tus credenciales en: https://pusher.com/
PUSHER_APP_KEY=TU_PUSHER_APP_KEY_AQUI
PUSHER_SECONDARY_APP_KEY=TU_PUSHER_SECONDARY_APP_KEY_AQUI
PUSHER_CLUSTER=mt1
# Si PUSHER_APP_KEY está vacío, Primary usará PUSHER_SECONDARY_APP_KEY

# App Settings
DEFAULT_RADIUS=20
OFFER_EXPIRATION_MINUTES=5
DEFAULT_ZOOM=15.0
